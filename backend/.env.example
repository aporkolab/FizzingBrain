# Database connection
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# HTTP server
PORT=3000
# Comma separated list of allowed origins; empty or * allows every origin
CORS_ORIGIN=

# Authentication (required): a long random string used to sign the JWTs
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Set to true to (re)create the tables and load the sample data on start-up.
# WARNING: deletes every existing user.
SEED_DATABASE=false

LOG_LEVEL=info
